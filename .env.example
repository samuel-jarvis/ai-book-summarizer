PROJECT_NAME="AI Book Summarizer"
DEEPSEEK_API_KEY="replace-with-your-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
CONVERSATION_MODEL="deepseek-v4-flash"
SECRET_KEY="replace-with-a-random-secret-at-least-32-bytes"
ENVIRONMENT=development
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Used when running Python directly. Compose overrides these with db/redis hosts.
DATABASE_URL="postgresql+asyncpg://book_user:local_book_password@localhost:5432/book_summarizer"
REDIS_URL="redis://localhost:6379/0"

# Local Compose database settings. Use URL-safe characters in these values.
POSTGRES_USER=book_user
POSTGRES_PASSWORD=local_book_password
POSTGRES_DB=book_summarizer
BACKEND_PORT=8000
